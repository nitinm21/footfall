# ─────────────────────────────────────────────────────────────────────────────
# Footfall environment template.
# Copy to `.env.local` and fill in. Every secret the project will ever need is
# listed here with the phase that introduces it. All values below are placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# ── Event store: Tinybird (managed ClickHouse) — Phase 4 ─────────────────────
# Write/read token for the Footfall Tinybird workspace.
TINYBIRD_TOKEN=
# Region host, e.g. https://api.tinybird.co or https://api.us-east.tinybird.co
TINYBIRD_HOST=https://api.tinybird.co

# ── App metadata store: Neon / Vercel Postgres — Phase 5 ─────────────────────
# Users, sites, tokens, fixes. OLTP, not analytics.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Auth.js with GitHub OAuth — Phase 5 ──────────────────────────────────────
# `openssl rand -base64 33` for AUTH_SECRET.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_URL=http://localhost:3000

# ── Live snippet + ingestion — Phase 4 ───────────────────────────────────────
# Per-site write token issued by the app; goes in the instrumented site's env.
FOOTFALL_TOKEN=
# Where @footfall/next POSTs events.
FOOTFALL_INGEST_URL=http://localhost:3000/api/ingest
# Kill switch — set to "1" to stop all event emission from the middleware.
FOOTFALL_DISABLED=
# Server-side salt for IP hashing; rotates daily in production. Never shipped to clients.
FOOTFALL_IP_SALT=

# ── Email digests + alerts: Resend — Phase 6 ─────────────────────────────────
RESEND_API_KEY=
