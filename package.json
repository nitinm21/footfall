{
  "name": "footfall",
  "version": "0.0.0",
  "private": true,
  "description": "Agent-experience analytics: Google Analytics + Hotjar, except the visitor is Claude Code.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm -r test",
    "capture": "tsx scripts/capture.ts",
    "fixtures:validate": "tsx scripts/fixtures-validate.ts",
    "accuracy": "tsx scripts/accuracy.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@footfall/core": "workspace:*",
    "@playwright/test": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
