# Status corrections from server-side beacons (5xx via instrumentation onRequestError).
# Correlated to events by request_id. Mirrors CorrectionSchema in core/src/ingest.ts.

SCHEMA >
    `request_id` String `json:$.request_id`,
    `status` Int16 `json:$.status`,
    `path` Nullable(String) `json:$.path`,
    `ts` Int64 `json:$.ts`

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(fromUnixTimestamp64Milli(ts))"
ENGINE_SORTING_KEY "request_id, ts"

TOKEN "footfall_ingest" APPEND
